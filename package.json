{
  "name": "khorshed-pro",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal developer website, technical publication, and knowledge hub for Khorshed Alam (https://khorshed.pro).",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "article:new": "node scripts/new-article.mjs",
    "og:generate": "node scripts/generate-og-images.mjs",
    "social:generate": "node scripts/generate-social-package.mjs",
    "build": "npm run og:generate && npm run validate:articles && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate:articles": "node scripts/validate-articles.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "check": "npm run og:generate && npm run validate:articles && astro check && tsc --noEmit",
    "test": "node --test tests/article-engine.test.mjs",
    "test:build": "node --test tests/build-output.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "latest",
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "@fontsource-variable/inter": "latest",
    "@fontsource-variable/jetbrains-mono": "latest",
    "@lucide/astro": "latest",
    "@tailwindcss/vite": "latest",
    "astro": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "latest"
  }
}
