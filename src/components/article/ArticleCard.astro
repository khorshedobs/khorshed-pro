---
import { ArrowRight } from '@lucide/astro';
import type { ArticleEntry } from '@/lib/content';
import { formatDate, formatIsoDate } from '@/lib/date';
import { getReadingTime } from '@/lib/reading-time';
import Badge from '@/components/ui/Badge.astro';

interface Props {
  article: ArticleEntry;
}

const { article } = Astro.props;
const readingTime = getReadingTime(article.body);
const articleUrl = `/articles/${article.id}/`;
---

<article class="editorial-card group flex h-full flex-col justify-between p-6 sm:p-7">
  <div>
    <div class="mb-3.5 flex flex-wrap items-center gap-2 text-xs">
      <span class="font-semibold tracking-wider text-[var(--accent)] uppercase">
        {article.data.category}
      </span>
      {
        article.data.phpVersion && (
          <>
            <span class="text-[var(--text-secondary)]/60" aria-hidden="true">
              &middot;
            </span>
            <span class="font-mono font-medium text-[var(--text-secondary)]">
              PHP {article.data.phpVersion}
            </span>
          </>
        )
      }
      {
        article.data.draft && (
          <Badge variant="notice">Draft</Badge>
        )
      }
    </div>

    <h3 class="text-lg font-semibold leading-snug tracking-tight text-[var(--text-primary)] sm:text-xl">
      <a
        href={articleUrl}
        class="transition-colors group-hover:text-[var(--accent)]"
      >
        {article.data.title}
      </a>
    </h3>

    <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
      {article.data.description}
    </p>
  </div>

  <div class="mt-6 flex items-center justify-between gap-4 border-t border-[var(--border-color)] pt-4 text-xs text-[var(--text-secondary)]">
    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
      <time datetime={formatIsoDate(article.data.publishedAt)}>
        {formatDate(article.data.publishedAt)}
      </time>
      <span aria-hidden="true">&middot;</span>
      <span>{readingTime.label}</span>
    </div>

    <a
      href={articleUrl}
      aria-label={`Read ${article.data.title}`}
      class="inline-flex shrink-0 items-center gap-1 font-medium text-[var(--accent)] transition-colors group-hover:text-[var(--accent-hover)]"
    >
      <span>Read</span>
      <ArrowRight
        class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
        aria-hidden="true"
      />
    </a>
  </div>
</article>
