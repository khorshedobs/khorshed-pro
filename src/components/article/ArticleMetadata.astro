---
import { Calendar, User } from '@lucide/astro';
import { formatDate, formatIsoDate } from '@/lib/date';
import ReadingTime from './ReadingTime.astro';

interface Props {
  publishedAt: Date;
  updatedAt?: Date;
  readingTimeLabel: string;
  author?: string;
  showAuthor?: boolean;
}

const {
  publishedAt,
  updatedAt,
  readingTimeLabel,
  author,
  showAuthor = false,
} = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[var(--text-secondary)] sm:text-sm">
  {
    showAuthor && author && (
      <span class="inline-flex items-center gap-1.5">
        <User class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
        <span>{author}</span>
      </span>
    )
  }

  <span class="inline-flex items-center gap-1.5">
    <Calendar class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
    <time datetime={formatIsoDate(publishedAt)}>{formatDate(publishedAt)}</time>
  </span>

  {
    updatedAt && (
      <span class="inline-flex items-center gap-1">
        <span>Updated</span>
        <time datetime={formatIsoDate(updatedAt)}>{formatDate(updatedAt)}</time>
      </span>
    )
  }

  <ReadingTime label={readingTimeLabel} />
</div>
