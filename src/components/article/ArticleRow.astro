---
import { ArrowRight } from '@lucide/astro';
import type { ArticleEntry } from '@/lib/content';
import { formatDate, formatIsoDate } from '@/lib/date';
import { getReadingTime } from '@/lib/reading-time';

interface Props {
  article: ArticleEntry;
}

const { article } = Astro.props;
const readingTime = getReadingTime(article.body);
const articleUrl = `/articles/${article.id}/`;
---

<article class="group py-6 first:pt-2 last:pb-2">
  <div class="grid gap-3 md:grid-cols-12 md:items-baseline md:gap-8">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--text-secondary)] md:col-span-3 md:flex-col md:items-start md:gap-1.5">
      <time
        datetime={formatIsoDate(article.data.publishedAt)}
        class="font-medium text-[var(--text-primary)]"
      >
        {formatDate(article.data.publishedAt)}
      </time>
      <div class="flex items-center gap-2">
        {
          article.data.phpVersion && (
            <span class="font-mono text-[var(--accent)]">
              PHP {article.data.phpVersion}
            </span>
          )
        }
        {article.data.phpVersion && <span aria-hidden="true">&middot;</span>}
        <span>{readingTime.label}</span>
      </div>
    </div>

    <div class="md:col-span-9">
      <div class="mb-1.5 flex flex-wrap items-center gap-2 text-xs">
        <span class="font-semibold tracking-wider text-[var(--accent)] uppercase">
          {article.data.category}
        </span>
        {
          article.data.difficulty && (
            <>
              <span class="text-[var(--text-secondary)]/50" aria-hidden="true">
                &middot;
              </span>
              <span class="text-[var(--text-secondary)]">
                {article.data.difficulty}
              </span>
            </>
          )
        }
      </div>

      <h3 class="text-lg font-semibold leading-snug tracking-tight text-[var(--text-primary)] sm:text-xl">
        <a
          href={articleUrl}
          class="transition-colors group-hover:text-[var(--accent)]"
        >
          {article.data.title}
        </a>
      </h3>

      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--text-secondary)]">
        {article.data.description}
      </p>

      <a
        href={articleUrl}
        class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--accent)] transition-colors group-hover:text-[var(--accent-hover)]"
      >
        <span>Read article</span>
        <ArrowRight
          class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</article>
