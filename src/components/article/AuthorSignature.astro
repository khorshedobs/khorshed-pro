---
import { ArrowRight } from '@lucide/astro';
import { getConfiguredSocials, siteConfig } from '@/config/site';
import SocialIcon from '@/components/ui/SocialIcon.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const socials = getConfiguredSocials();
---

<aside
  aria-label="About the author"
  class={`rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] ${
    compact ? 'p-6' : 'p-7 sm:p-8'
  }`}
>
  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex items-start gap-4">
      <div
        aria-hidden="true"
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[var(--accent)]/35 bg-[var(--accent-subtle)] font-mono text-sm font-bold tracking-tight text-[var(--accent)]"
      >
        {siteConfig.monogram}
      </div>

      <div class="max-w-xl">
        <p class="text-xs font-semibold tracking-wider text-[var(--accent)] uppercase">
          Written by
        </p>
        <h2 class="mt-0.5 text-lg font-bold tracking-tight text-[var(--text-primary)]">
          {siteConfig.author.name}
        </h2>
        <p class="text-xs font-medium text-[var(--text-secondary)]">
          {siteConfig.author.role}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
          {siteConfig.author.bioShort}
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium">
          <a
            href="/about/"
            class="inline-flex items-center gap-1 text-[var(--accent)] transition-colors hover:text-[var(--accent-hover)]"
          >
            <span>More about me</span>
            <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
          <a
            href="/series/modern-php-mastery/"
            class="text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)]"
          >
            Modern PHP Mastery Series
          </a>
        </div>
      </div>
    </div>

    {
      socials.length > 0 && (
        <div class="flex shrink-0 items-center gap-2">
          {socials.map((profile) => (
            <a
              href={profile.href}
              aria-label={profile.label}
              title={profile.label}
              target={profile.key === 'email' ? undefined : '_blank'}
              rel={profile.key === 'email' ? undefined : 'noopener noreferrer'}
              class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--text-secondary)] transition-colors hover:border-[var(--accent)] hover:text-[var(--text-primary)]"
            >
              <SocialIcon network={profile.key} class="h-4 w-4" />
            </a>
          ))}
        </div>
      )
    }
  </div>
</aside>
