---
import { Cpu } from '@lucide/astro';
import { buildCompatibilityDisplay } from '@/lib/content';

interface Props {
  phpVersion?: string;
  minimumPhpVersion?: string;
  testedPhpVersions?: string[];
  requiredExtensions?: string[];
  deprecatedIn?: string;
  removedIn?: string;
}

const props = Astro.props;
const compat = buildCompatibilityDisplay(props);
---

{
  compat.hasData && (
    <section
      aria-label="PHP version compatibility"
      class="mt-6 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] px-4 py-3.5 sm:px-5"
    >
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2.5 text-xs sm:text-sm">
        <div class="inline-flex items-center gap-1.5 font-semibold text-[var(--accent)]">
          <Cpu class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span>Compatibility</span>
        </div>

        <dl class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs">
          {compat.introducedIn && (
            <div class="flex items-center gap-1.5">
              <dt class="text-[var(--text-secondary)]">Introduced in:</dt>
              <dd class="font-mono font-semibold text-[var(--text-primary)]">
                PHP {compat.introducedIn}
              </dd>
            </div>
          )}

          {compat.minimumPhpVersion && (
            <div class="flex items-center gap-1.5">
              <dt class="text-[var(--text-secondary)]">Minimum PHP:</dt>
              <dd class="font-mono font-semibold text-[var(--text-primary)]">
                {compat.minimumPhpVersion}
              </dd>
            </div>
          )}

          {compat.testedPhpVersions.length > 0 && (
            <div class="flex items-center gap-1.5">
              <dt class="text-[var(--text-secondary)]">Tested on:</dt>
              <dd class="font-mono font-medium text-[var(--text-primary)]">
                {compat.testedPhpVersions.join(', ')}
              </dd>
            </div>
          )}

          <div class="flex items-center gap-1.5">
            <dt class="text-[var(--text-secondary)]">Required extensions:</dt>
            <dd class="font-mono text-[var(--text-primary)]">
              {compat.requiredExtensionsLabel}
            </dd>
          </div>

          {compat.deprecatedIn && (
            <div class="flex items-center gap-1.5">
              <dt class="text-[var(--text-secondary)]">Deprecated in:</dt>
              <dd class="font-mono text-amber-700 dark:text-amber-300">
                PHP {compat.deprecatedIn}
              </dd>
            </div>
          )}

          {compat.removedIn && (
            <div class="flex items-center gap-1.5">
              <dt class="text-[var(--text-secondary)]">Removed in:</dt>
              <dd class="font-mono text-rose-700 dark:text-rose-300">
                PHP {compat.removedIn}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </section>
  )
}
