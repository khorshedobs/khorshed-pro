---
interface Props {
  targetId?: string;
}

const { targetId = 'article-content-body' } = Astro.props;
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed top-0 right-0 left-0 z-50 h-0.5 bg-transparent"
>
  <div
    id="reading-progress-bar"
    data-progress-target={targetId}
    class="h-full w-full origin-left scale-x-0 bg-[var(--accent)] transition-transform duration-75 ease-out motion-reduce:transition-none"
  />
</div>

<script>
  function initReadingProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    const targetId = bar.getAttribute('data-progress-target') || 'article-content-body';
    const target = document.getElementById(targetId);
    if (!target) return;

    let rafPending = false;

    const updateProgress = () => {
      rafPending = false;
      const rect = target.getBoundingClientRect();
      const scrollTop = window.scrollY;
      const articleTop = scrollTop + rect.top;
      const articleHeight = target.offsetHeight;
      const viewportHeight = window.innerHeight;

      const scrollable = Math.max(1, articleHeight - viewportHeight * 0.65);
      const raw = (scrollTop - articleTop + viewportHeight * 0.2) / scrollable;
      const clamped = Math.min(1, Math.max(0, raw));
      bar.style.transform = `scaleX(${clamped.toFixed(4)})`;
    };

    const scheduleUpdate = () => {
      if (rafPending) return;
      rafPending = true;
      window.requestAnimationFrame(updateProgress);
    };

    updateProgress();
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
  }

  initReadingProgress();
  document.addEventListener('astro:after-swap', initReadingProgress);
</script>
