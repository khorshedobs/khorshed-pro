---
import { Clock } from '@lucide/astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="inline-flex items-center gap-1.5 text-xs text-[var(--text-secondary)] sm:text-sm">
  <Clock class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
  <span>{label}</span>
</span>
