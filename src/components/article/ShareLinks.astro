---
import { Check, Copy, Share2 } from '@lucide/astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const xShareUrl = `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
---

<div
  class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] px-5 py-4"
>
  <div class="flex items-center gap-2 text-sm font-medium text-[var(--text-primary)]">
    <Share2 class="h-4 w-4 text-[var(--accent)]" aria-hidden="true" />
    <span>Share this article</span>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <button
      type="button"
      data-copy-link={url}
      class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-primary)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--accent)] hover:text-[var(--text-primary)]"
      aria-label="Copy article link"
    >
      <Copy class="copy-link-icon h-3.5 w-3.5" aria-hidden="true" />
      <Check class="check-link-icon hidden h-3.5 w-3.5 text-[var(--accent)]" aria-hidden="true" />
      <span class="copy-link-label">Copy link</span>
    </button>

    <a
      href={xShareUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-primary)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--accent)] hover:text-[var(--text-primary)]"
      aria-label="Share on X"
    >
      <SocialIcon network="x" class="h-3.5 w-3.5" />
      <span>Share on X</span>
    </a>

    <a
      href={linkedInShareUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-primary)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--accent)] hover:text-[var(--text-primary)]"
      aria-label="Share on LinkedIn"
    >
      <SocialIcon network="linkedin" class="h-3.5 w-3.5" />
      <span>LinkedIn</span>
    </a>
  </div>
</div>

<script>
  function initShareCopyLinks() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';

      button.addEventListener('click', async () => {
        const targetUrl = button.getAttribute('data-copy-link');
        if (!targetUrl) return;

        try {
          await navigator.clipboard.writeText(targetUrl);
          const copyIcon = button.querySelector('.copy-link-icon');
          const checkIcon = button.querySelector('.check-link-icon');
          const label = button.querySelector('.copy-link-label');

          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (label) label.textContent = 'Copied!';

          window.setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (label) label.textContent = 'Copy link';
          }, 2000);
        } catch {
          // Clipboard access denied
        }
      });
    });
  }

  initShareCopyLinks();
  document.addEventListener('astro:after-swap', initShareCopyLinks);
</script>
