---
import { List } from '@lucide/astro';
import type { MarkdownHeading } from 'astro';
import { filterTocHeadings } from '@/lib/content';

interface Props {
  headings: MarkdownHeading[];
  variant?: 'sidebar' | 'mobile';
}

const { headings, variant = 'sidebar' } = Astro.props;
const tocHeadings = filterTocHeadings(headings, 2, 3);
---

{
  tocHeadings.length > 0 && variant === 'sidebar' && (
    <>
      <aside aria-label="Table of contents" class="hidden lg:block">
        <div class="sticky top-24 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5">
          <div class="mb-3.5 flex items-center gap-2 text-xs font-semibold tracking-wider text-[var(--text-primary)] uppercase">
            <List class="h-3.5 w-3.5 text-[var(--accent)]" aria-hidden="true" />
            <span>On this page</span>
          </div>
          <nav aria-label="Article sections">
            <ul class="space-y-2 border-l border-[var(--border-color)] pl-3 text-sm">
              {tocHeadings.map((heading) => (
                <li class={heading.depth === 3 ? 'pl-3' : ''}>
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link={heading.slug}
                    class="block leading-snug text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>

      <script>
        let activeTocObserver: IntersectionObserver | null = null;

        function initTocAndHeadingAnchors() {
          if (activeTocObserver) {
            activeTocObserver.disconnect();
            activeTocObserver = null;
          }

          // Enhance article h2/h3 headings with direct anchor links + copy-link click feedback
          const articleBody = document.getElementById('article-content-body');
          if (articleBody) {
            const proseHeadings = articleBody.querySelectorAll<HTMLElement>('h2[id], h3[id]');
            proseHeadings.forEach((heading) => {
              if (heading.querySelector('.heading-anchor-btn')) return;
              const id = heading.getAttribute('id');
              if (!id) return;

              const anchor = document.createElement('a');
              anchor.className = 'heading-anchor-btn';
              anchor.href = `#${id}`;
              anchor.textContent = '#';
              anchor.setAttribute(
                'aria-label',
                `Copy direct link to section: ${heading.textContent?.trim() ?? id}`,
              );
              anchor.setAttribute('title', 'Copy link to this section');

              anchor.addEventListener('click', async () => {
                const url = `${window.location.origin}${window.location.pathname}#${id}`;
                if (navigator.clipboard && window.isSecureContext) {
                  try {
                    await navigator.clipboard.writeText(url);
                    anchor.textContent = '✓';
                    window.setTimeout(() => {
                      anchor.textContent = '#';
                    }, 1500);
                  } catch {
                    // Normal hash navigation still proceeds
                  }
                }
              });

              heading.appendChild(anchor);
            });
          }

          // Close mobile <details> TOC when a section link is clicked
          document.querySelectorAll<HTMLDetailsElement>('[data-mobile-toc]').forEach((details) => {
            if (details.dataset.bound === 'true') return;
            details.dataset.bound = 'true';
            details.querySelectorAll('a').forEach((link) => {
              link.addEventListener('click', () => {
                details.open = false;
              });
            });
          });

          const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
          );
          if (!links.length) return;

          const headings = links
            .map((link) => {
              const id = link.getAttribute('data-toc-link');
              return id ? document.getElementById(id) : null;
            })
            .filter((el): el is HTMLElement => el !== null);

          if (!headings.length) return;

          const setActive = (activeId: string) => {
            for (const link of links) {
              const isMatch = link.getAttribute('data-toc-link') === activeId;
              link.classList.toggle('is-active', isMatch);
              if (isMatch) {
                link.setAttribute('aria-current', 'location');
              } else {
                link.removeAttribute('aria-current');
              }
            }
          };

          setActive(headings[0].id);

          const syncClosestHeading = () => {
            let currentId = headings[0].id;
            for (const h of headings) {
              if (h.getBoundingClientRect().top <= 130) {
                currentId = h.id;
              } else {
                break;
              }
            }
            setActive(currentId);
          };

          links.forEach((link) => {
            link.addEventListener('click', () => {
              const targetId = link.getAttribute('data-toc-link');
              if (targetId) setActive(targetId);
            });
          });

          activeTocObserver = new IntersectionObserver(
            (entries) => {
              const visible = entries
                .filter((entry) => entry.isIntersecting)
                .sort(
                  (a, b) =>
                    a.target.getBoundingClientRect().top -
                    b.target.getBoundingClientRect().top,
                );
              if (visible[0]?.target.id) {
                setActive(visible[0].target.id);
              } else {
                syncClosestHeading();
              }
            },
            {
              rootMargin: '-96px 0px -65% 0px',
              threshold: [0, 1],
            },
          );

          headings.forEach((heading) => activeTocObserver?.observe(heading));
        }

        initTocAndHeadingAnchors();
        document.addEventListener('astro:after-swap', initTocAndHeadingAnchors);
      </script>
    </>
  )
}

{
  tocHeadings.length > 0 && variant === 'mobile' && (
    <details
      data-mobile-toc
      class="mb-8 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-4 lg:hidden"
    >
      <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-[var(--text-primary)]">
        <List class="h-4 w-4 text-[var(--accent)]" aria-hidden="true" />
        <span>Table of contents</span>
      </summary>
      <nav aria-label="Article sections" class="mt-3 border-t border-[var(--border-color)] pt-3">
        <ul class="space-y-2 text-sm">
          {tocHeadings.map((heading) => (
            <li class={heading.depth === 3 ? 'pl-3' : ''}>
              <a
                href={`#${heading.slug}`}
                class="block leading-snug text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}
