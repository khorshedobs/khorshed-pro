---
interface Props {
  class?: string;
  size?: 'default' | 'narrow' | 'wide';
}

const { class: className = '', size = 'default' } = Astro.props;

const maxWidths = {
  narrow: 'max-w-4xl',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
}[size];
---

<div class={`mx-auto w-full px-4 sm:px-6 lg:px-8 ${maxWidths} ${className}`.trim()}>
  <slot />
</div>
