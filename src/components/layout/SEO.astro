---
import { getSameAsUrls, siteConfig } from '@/config/site';
import type { BreadcrumbItem } from '@/components/ui/Breadcrumbs.astro';

export interface ArticleSeoMeta {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  tags: string[];
  category: string;
  image?: string;
}

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  isHomepage?: boolean;
  article?: ArticleSeoMeta;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = siteConfig.defaultDescription,
  canonicalURL,
  image = '/og/default.png',
  type = 'website',
  noindex = false,
  isHomepage = false,
  article,
  breadcrumbs,
} = Astro.props;

const pageTitle = title
  ? `${title} — ${siteConfig.siteName}`
  : siteConfig.siteTitle;

const resolvedCanonical =
  canonicalURL ?? new URL(Astro.url.pathname, siteConfig.siteUrl).href;

const resolvedImage = new URL(image, siteConfig.siteUrl).href;
const resolvedImageAlt = article?.title ?? siteConfig.seo.defaultImageAlt;

const sameAs = getSameAsUrls();

const jsonLdPayloads: Record<string, unknown>[] = [];

if (isHomepage) {
  const personPayload: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: siteConfig.author.name,
    url: siteConfig.siteUrl,
    jobTitle: siteConfig.author.role,
    description: siteConfig.defaultDescription,
  };
  if (sameAs.length > 0) {
    personPayload.sameAs = sameAs;
  }
  jsonLdPayloads.push(personPayload);

  jsonLdPayloads.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
    description: siteConfig.defaultDescription,
    inLanguage: siteConfig.language,
    author: {
      '@type': 'Person',
      name: siteConfig.author.name,
    },
  });
}

if (article) {
  const blogPosting: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: article.title,
    description: article.description,
    datePublished: article.publishedAt.toISOString(),
    dateModified: (article.updatedAt ?? article.publishedAt).toISOString(),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': resolvedCanonical,
    },
    author: {
      '@type': 'Person',
      name: article.author,
      url: siteConfig.siteUrl,
    },
    publisher: {
      '@type': 'Person',
      name: siteConfig.author.name,
      url: siteConfig.siteUrl,
    },
    articleSection: article.category,
    keywords: article.tags,
    inLanguage: siteConfig.language,
  };
  if (resolvedImage) {
    blogPosting.image = resolvedImage;
  }
  jsonLdPayloads.push(blogPosting);
}

if (breadcrumbs && breadcrumbs.length > 0) {
  jsonLdPayloads.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      item: crumb.href
        ? new URL(crumb.href, siteConfig.siteUrl).href
        : resolvedCanonical,
    })),
  });
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={article?.author ?? siteConfig.author.name} />
<link rel="canonical" href={resolvedCanonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteConfig.siteName} RSS Feed`}
  href={new URL('/rss.xml', siteConfig.siteUrl).href}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.siteName} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={resolvedImageAlt} />

{
  article && (
    <>
      <meta
        property="article:published_time"
        content={article.publishedAt.toISOString()}
      />
      {article.updatedAt && (
        <meta
          property="article:modified_time"
          content={article.updatedAt.toISOString()}
        />
      )}
      <meta property="article:author" content={article.author} />
      <meta property="article:section" content={article.category} />
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImage} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />

{
  jsonLdPayloads.map((payload) => (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(payload)}
    />
  ))
}
