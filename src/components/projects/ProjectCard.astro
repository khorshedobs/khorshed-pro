---
import { ArrowRight, ExternalLink } from '@lucide/astro';
import type { ProjectEntry } from '@/lib/content';
import Badge from '@/components/ui/Badge.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const projectUrl = `/projects/${project.id}/`;
const statusLabel = project.data.isSample
  ? 'Architecture Blueprint'
  : project.data.status;
---

<article class="editorial-card group flex h-full flex-col justify-between p-6 sm:p-7">
  <div>
    <div class="mb-3.5 flex flex-wrap items-center justify-between gap-2">
      <span class="text-xs font-semibold tracking-wider text-[var(--accent)] uppercase">
        {project.data.projectType}
      </span>
      <Badge variant={project.data.isSample ? 'subtle' : 'accent'}>
        {statusLabel}
      </Badge>
    </div>

    <h3 class="text-lg font-semibold tracking-tight text-[var(--text-primary)] sm:text-xl">
      <a
        href={projectUrl}
        class="transition-colors group-hover:text-[var(--accent)]"
      >
        {project.data.title}
      </a>
    </h3>

    <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
      <span class="font-medium text-[var(--text-primary)]">Problem:</span>{' '}
      {project.data.problem}
    </p>
  </div>

  <div class="mt-6 space-y-4 border-t border-[var(--border-color)] pt-4">
    <ul class="flex flex-wrap gap-1.5" aria-label="Technologies">
      {
        project.data.technologies.map((tech) => (
          <li class="rounded-md border border-[var(--border-color)] bg-[var(--bg-primary)] px-2 py-0.5 font-mono text-xs text-[var(--text-secondary)]">
            {tech}
          </li>
        ))
      }
    </ul>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <a
        href={projectUrl}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--accent)] transition-colors group-hover:text-[var(--accent-hover)]"
      >
        <span>Read case study</span>
        <ArrowRight
          class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>

      <div class="flex items-center gap-3">
        {
          project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${project.data.title} GitHub repository`}
              class="inline-flex items-center gap-1 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)]"
            >
              <SocialIcon network="github" class="h-3.5 w-3.5" />
              <span>GitHub</span>
            </a>
          )
        }
        {
          project.data.demoUrl && (
            <a
              href={project.data.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${project.data.title} live demo`}
              class="inline-flex items-center gap-1 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)]"
            >
              <span>Demo</span>
              <ExternalLink class="h-3 w-3" aria-hidden="true" />
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>
