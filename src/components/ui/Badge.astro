---
interface Props {
  variant?: 'default' | 'accent' | 'subtle' | 'notice';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variants = {
  default:
    'bg-[var(--bg-elevated)] text-[var(--text-secondary)] border-[var(--border-color)]',
  accent:
    'bg-[var(--accent-subtle)] text-[var(--accent)] border-transparent font-semibold',
  subtle:
    'bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-color)]',
  notice:
    'bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/25',
}[variant];
---

<span
  class={`inline-flex items-center gap-1.5 rounded-md border px-2.5 py-0.5 text-xs font-medium leading-5 ${variants} ${className}`.trim()}
>
  <span><slot /></span>
</span>
