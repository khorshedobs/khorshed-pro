---
import { ArrowRight, BookOpen, FolderGit2, Mic } from '@lucide/astro';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import Breadcrumbs, { type BreadcrumbItem } from '@/components/ui/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'About' },
];

const engineeringPrinciples = [
  {
    number: '01',
    title: 'Clarity and Maintainability',
    description:
      'Code is read far more often than it is written. Explicit types, small single-purpose components, and clear boundaries keep systems understandable years after initial release.',
  },
  {
    number: '02',
    title: 'Pragmatic Architecture',
    description:
      'Choose tools proportional to the problem: static HTML where content is static, structured service layers in backend applications, and minimal dependencies that earn their maintenance cost.',
  },
  {
    number: '03',
    title: 'Verification by Default',
    description:
      'Automated tests, strict static analysis, and reproducible deployment pipelines reduce operational surprises and give teams confidence to ship cleanly.',
  },
];
---

<BaseLayout
  title="About"
  description="Engineering background, technical focus areas, software principles, and writing by Khorshed Alam."
  breadcrumbs={breadcrumbs}
>
  <Container class="py-12 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Editorial Introduction -->
    <section aria-labelledby="about-heading" class="grid gap-10 border-b border-[var(--border-color)] pb-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="text-xs font-semibold tracking-wider text-[var(--accent)] uppercase">
          About
        </p>
        <h1 id="about-heading" class="heading-page mt-2">
          {siteConfig.siteName}
        </h1>
        <p class="mt-2.5 text-lg font-medium text-[var(--text-secondary)]">
          {siteConfig.author.role}
        </p>

        <div class="mt-6 max-w-2xl space-y-4 text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
          <p>
            I&apos;m <strong class="text-[var(--text-primary)]">{siteConfig.siteName}</strong>,
            a software engineer and technical writer sharing engineering notes and system designs at{' '}
            <strong class="text-[var(--text-primary)]">khorshed.pro</strong>.
          </p>
          <p>
            My focus is building dependable backend and full-stack web software across modern PHP,
            Laravel, WordPress, and TypeScript—prioritizing explicit contracts, defensive
            integrations, and codebases that stay legible for future maintainers.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/articles/" variant="primary">
            <BookOpen class="h-4 w-4" aria-hidden="true" />
            <span>Explore Articles</span>
          </Button>
          <Button href="/projects/" variant="secondary">
            <FolderGit2 class="h-4 w-4" aria-hidden="true" />
            <span>View Projects</span>
          </Button>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 sm:p-7">
          <h2 class="text-xs font-semibold tracking-wider text-[var(--accent)] uppercase">
            Current Focus
          </h2>
          <dl class="mt-5 space-y-4 text-sm">
            <div class="border-b border-[var(--border-color)] pb-4">
              <dt class="font-semibold text-[var(--text-primary)]">
                Flagship Publication
              </dt>
              <dd class="mt-1 text-[var(--text-secondary)]">
                Writing <a href="/series/modern-php-mastery/" class="font-medium text-[var(--accent)] hover:underline">Modern PHP Mastery: 8.0 → 8.6</a>—practical chapters on language evolution and clean domain modeling.
              </dd>
            </div>
            <div class="border-b border-[var(--border-color)] pb-4">
              <dt class="font-semibold text-[var(--text-primary)]">
                Primary Ecosystems
              </dt>
              <dd class="mt-1 text-[var(--text-secondary)]">
                PHP, Laravel, WordPress &amp; WooCommerce, TypeScript, and static web tooling.
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-[var(--text-primary)]">
                Engineering Interests
              </dt>
              <dd class="mt-1 text-[var(--text-secondary)]">
                Webhook reliability, idempotent API design, automated testing, and static-first performance.
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </section>

    <!-- Structured Technical Expertise Matrix -->
    <section aria-labelledby="technologies-heading" class="pt-14">
      <SectionHeading
        id="technologies-heading"
        eyebrow="Technical Expertise"
        title="Ecosystems & Capabilities"
        description="Core technologies and architectural concerns addressed across engineering work and technical writing."
      />

      <div class="divide-y divide-[var(--border-color)] border-y border-[var(--border-color)]">
        {
          siteConfig.expertiseCategories.map((category) => (
            <div class="grid gap-4 py-6 md:grid-cols-12 md:items-start md:gap-8">
              <div class="md:col-span-4">
                <h3 class="text-base font-semibold text-[var(--text-primary)]">
                  {category.title}
                </h3>
              </div>
              <div class="md:col-span-5">
                <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
                  {category.summary}
                </p>
              </div>
              <div class="md:col-span-3">
                <ul class="flex flex-wrap gap-1.5">
                  {category.items.map((item) => (
                    <li class="rounded-md border border-[var(--border-color)] bg-[var(--bg-surface)] px-2 py-0.5 font-mono text-xs text-[var(--text-secondary)]">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Engineering Principles -->
    <section aria-labelledby="philosophy-heading" class="mt-16 pt-4">
      <SectionHeading
        id="philosophy-heading"
        eyebrow="Approach"
        title="Engineering Principles"
      />

      <div class="grid gap-8 md:grid-cols-3">
        {
          engineeringPrinciples.map((principle) => (
            <div class="border-t-2 border-[var(--accent)]/60 pt-5">
              <span class="font-mono text-xs font-semibold text-[var(--accent)]">
                {principle.number}
              </span>
              <h3 class="mt-2 text-lg font-semibold text-[var(--text-primary)]">
                {principle.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-[var(--text-secondary)]">
                {principle.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Writing, Open Source, Speaking -->
    <section
      aria-labelledby="community-heading"
      class="mt-16 border-t border-[var(--border-color)] pt-14"
    >
      <SectionHeading
        id="community-heading"
        eyebrow="Community & Sharing"
        title="Technical Writing, Open Source & Speaking"
      />

      <div class="grid gap-6 md:grid-cols-3">
        <div class="editorial-card flex flex-col justify-between p-6">
          <div>
            <h3 class="text-base font-semibold text-[var(--text-primary)]">
              Technical Writing
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-[var(--text-secondary)]">
              Publishing structured guides—beginning with{' '}
              <strong class="text-[var(--text-primary)]">Modern PHP Mastery: 8.0 → 8.6</strong>—focused
              on real-world language features and maintainable system design.
            </p>
          </div>
          <a
            href="/series/modern-php-mastery/"
            class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--accent)] hover:text-[var(--accent-hover)]"
          >
            <span>Read the flagship series</span>
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>

        <div class="editorial-card flex flex-col justify-between p-6">
          <div>
            <h3 class="text-base font-semibold text-[var(--text-primary)]">
              Open-Source Interests
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-[var(--text-secondary)]">
              Interested in developer tooling, PHP and WordPress ecosystem standards,
              documentation quality, and focused utility packages.
            </p>
          </div>
          <a
            href="/projects/"
            class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--accent)] hover:text-[var(--accent-hover)]"
          >
            <span>Explore projects</span>
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>

        <div class="editorial-card flex flex-col justify-between p-6">
          <div>
            <h3 class="inline-flex items-center gap-2 text-base font-semibold text-[var(--text-primary)]">
              <Mic class="h-4 w-4 text-[var(--accent)]" aria-hidden="true" />
              <span>Speaking &amp; Workshops</span>
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-[var(--text-secondary)]">
              Open to developer meetups, technical conferences, and engineering team sessions
              on modern PHP, WordPress architecture, and resilient API design.
            </p>
          </div>
          <a
            href="/speaking/"
            class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--accent)] hover:text-[var(--accent-hover)]"
          >
            <span>View speaking topics</span>
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  </Container>
</BaseLayout>
