---
import { Rss } from '@lucide/astro';
import {
  getPublishedArticles,
  getUniqueCategories,
  getUniqueTags,
} from '@/lib/content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import Breadcrumbs, { type BreadcrumbItem } from '@/components/ui/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import FeaturedArticleLead from '@/components/article/FeaturedArticleLead.astro';
import ArticleRow from '@/components/article/ArticleRow.astro';

const articles = await getPublishedArticles();
const categories = getUniqueCategories(articles);
const tags = getUniqueTags(articles);

const tagCounts = new Map<string, number>();
for (const article of articles) {
  for (const tag of article.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const leadArticle = articles[0];
const archiveArticles = articles.slice(1);

const leadCodeExcerpt = leadArticle?.id === 'php-85-pipe-operator'
  ? `function normalizeSlug(string $title): string
{
    return $title
        |> trim(...)
        |> strtolower(...)
        |> (fn (string $s) => preg_replace(
            '/[^a-z0-9]+/',
            '-',
            $s,
        ) ?? '')
        |> (fn (string $s) => trim($s, '-'));
}`
  : undefined;

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Articles' },
];
---

<BaseLayout
  title="Articles"
  description="Technical articles on modern PHP, Laravel, WordPress, TypeScript, APIs, and software engineering architecture by Khorshed Alam."
  breadcrumbs={breadcrumbs}
>
  <Container class="py-12 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />

    <header class="flex flex-col gap-5 border-b border-[var(--border-color)] pb-9 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold tracking-wider text-[var(--accent)] uppercase">
          Technical Publication
        </p>
        <h1 class="heading-page mt-2">Articles</h1>
        <p class="mt-3.5 text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
          In-depth guides, language feature analyses, and practical engineering notes across modern
          PHP and web development.
        </p>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <Badge variant="subtle">
          {`${articles.length} ${articles.length === 1 ? 'published article' : 'published articles'}`}
        </Badge>
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--accent)] hover:text-[var(--text-primary)]"
        >
          <Rss class="h-3.5 w-3.5 text-[var(--accent)]" aria-hidden="true" />
          <span>RSS</span>
        </a>
      </div>
    </header>

    {
      articles.length === 0 ? (
        <div class="mt-12">
          <EmptyState
            icon="articles"
            title="No published articles yet"
            description="Reviewed technical articles will appear here chronologically as they are published."
            actionLabel="Explore Series"
            actionHref="/series/"
          />
        </div>
      ) : (
        <>
          {(categories.length > 0 || tags.length > 0) && (
            <section
              aria-label="Topics covered"
              class="mt-8 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-4 sm:p-5"
            >
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-xs font-semibold tracking-wider text-[var(--text-secondary)] uppercase">
                  Topics in Archive
                </p>
                <div class="flex flex-wrap items-center gap-2">
                  {categories.map((category) => (
                    <span class="inline-flex items-center rounded-md border border-[var(--border-color)] bg-[var(--bg-primary)] px-2.5 py-1 text-xs font-semibold text-[var(--text-primary)]">
                      {category}
                    </span>
                  ))}
                  {tags.map((tag) => (
                    <span class="inline-flex items-center gap-1.5 rounded-md border border-[var(--border-color)] bg-[var(--bg-primary)] px-2.5 py-1 font-mono text-xs text-[var(--text-secondary)]">
                      <span>{tag}</span>
                      <span class="text-[11px] opacity-70">
                        ({tagCounts.get(tag) ?? 0})
                      </span>
                    </span>
                  ))}
                </div>
              </div>
            </section>
          )}

          {leadArticle && (
            <section aria-labelledby="latest-lead-heading" class="mt-12">
              <SectionHeading
                id="latest-lead-heading"
                eyebrow="Most Recent"
                title="Latest Essay"
              />
              <FeaturedArticleLead
                article={leadArticle}
                codeExcerpt={leadCodeExcerpt}
                codeTitle="src/Support/Slugger.php"
              />
            </section>
          )}

          {archiveArticles.length > 0 && (
            <section
              aria-labelledby="all-articles-heading"
              class="mt-14 border-t border-[var(--border-color)] pt-12"
            >
              <SectionHeading
                id="all-articles-heading"
                eyebrow="Chronological Archive"
                title="Earlier Essays"
                description="Ordered sequentially from newest to oldest."
              />
              <div class="divide-y divide-[var(--border-color)] border-y border-[var(--border-color)]">
                {archiveArticles.map((article) => (
                  <ArticleRow article={article} />
                ))}
              </div>
            </section>
          )}
        </>
      )
    }
  </Container>
</BaseLayout>
