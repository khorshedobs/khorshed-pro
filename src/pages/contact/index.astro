---
import { ArrowRight, ArrowUpRight, Mail } from '@lucide/astro';
import { getConfiguredSocials, siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import Breadcrumbs, { type BreadcrumbItem } from '@/components/ui/Breadcrumbs.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Contact' },
];

const configuredSocials = getConfiguredSocials();
const hasEmail = Boolean(siteConfig.social.email);
---

<BaseLayout
  title="Contact"
  description="Contact channels and social profiles for Khorshed Alam."
  breadcrumbs={breadcrumbs}
>
  <Container class="py-12 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />

    <header class="max-w-2xl">
      <p class="text-xs font-semibold tracking-wider text-[var(--accent)] uppercase">
        Contact
      </p>
      <h1 class="heading-page mt-2">Get in Touch</h1>
      <p class="mt-4 text-lg leading-relaxed text-[var(--text-secondary)]">
        For technical collaboration, engineering discussions, open-source questions, or speaking
        invitations.
      </p>
    </header>

    <div class="mt-10 grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        {
          configuredSocials.length > 0 ? (
            <div class="grid gap-4 sm:grid-cols-2">
              {configuredSocials.map((profile) => (
                <a
                  href={profile.href}
                  target={profile.key === 'email' ? undefined : '_blank'}
                  rel={profile.key === 'email' ? undefined : 'noopener noreferrer'}
                  class="editorial-card group flex items-start justify-between gap-4 p-5"
                >
                  <div class="flex items-start gap-3.5">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--accent)]">
                      <SocialIcon network={profile.key} class="h-5 w-5" />
                    </div>
                    <div>
                      <h2 class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)]">
                        {profile.label}
                      </h2>
                      <p class="mt-1 break-all font-mono text-xs text-[var(--text-secondary)]">
                        {profile.handle ?? profile.href.replace(/^mailto:/, '')}
                      </p>
                    </div>
                  </div>
                  <ArrowUpRight
                    class="h-4 w-4 shrink-0 text-[var(--text-secondary)] transition-colors group-hover:text-[var(--accent)]"
                    aria-hidden="true"
                  />
                </a>
              ))}
            </div>
          ) : (
            <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 sm:p-8">
              <div class="flex items-start gap-3.5">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--accent)]">
                  <Mail class="h-5 w-5" aria-hidden="true" />
                </div>
                <div>
                  <h2 class="text-base font-semibold text-[var(--text-primary)]">
                    Direct Contact Channels Opening Soon
                  </h2>
                  <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
                    Verified email and public social profile links will be published here shortly.
                    In the meantime, feel free to explore ongoing technical writing and speaking
                    topics across the site.
                  </p>
                  <div class="mt-5 flex flex-wrap gap-4 text-sm font-medium">
                    <a
                      href="/articles/"
                      class="inline-flex items-center gap-1.5 text-[var(--accent)] hover:text-[var(--accent-hover)]"
                    >
                      <span>Browse Articles</span>
                      <ArrowRight class="h-4 w-4" aria-hidden="true" />
                    </a>
                    <a
                      href="/speaking/"
                      class="inline-flex items-center gap-1.5 text-[var(--accent)] hover:text-[var(--accent-hover)]"
                    >
                      <span>Speaking Topics</span>
                      <ArrowRight class="h-4 w-4" aria-hidden="true" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          )
        }
      </div>

      <aside class="lg:col-span-5">
        <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6">
          <div class="flex items-center gap-2 text-sm font-semibold text-[var(--text-primary)]">
            <Mail class="h-4 w-4 text-[var(--accent)]" aria-hidden="true" />
            <span>Collaboration &amp; Speaking</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
            {hasEmail
              ? `Direct inquiries can be sent to ${siteConfig.social.email}.`
              : 'Topics I frequently collaborate and write on include PHP language engineering, Laravel architecture, WordPress & WooCommerce extensibility, and API reliability.'}
          </p>
          <div class="mt-5 border-t border-[var(--border-color)] pt-4 text-xs text-[var(--text-secondary)]">
            Interested in conference sessions or workshops? Visit the{' '}
            <a href="/speaking/" class="font-medium text-[var(--accent)] hover:underline">
              Speaking page
            </a>
            .
          </div>
        </div>
      </aside>
    </div>
  </Container>
</BaseLayout>
